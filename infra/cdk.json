{
  "app": "uv run python app.py",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "cdk.out",
      ".venv"
    ]
  },
  "context": {
    "@aws-cdk/core:enableDiffNoFail": true,
    "@aws-cdk/core:defaultCrossStackReferences": "strong",
    "db_open_to_internet": false,
    "@aws-cdk/aws-ec2:uniqueImdsv2TemplateName": true,
    "domain": "syrenka.me"
  }
}
