[Unit]
Description=Warszawa Live API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=warszawa
WorkingDirectory=@ROOT@/backend
EnvironmentFile=/etc/warszawa/instance.env
EnvironmentFile=/etc/warszawa/release.env
# port 80 without root; CloudFront terminates TLS and is the only allowed client (security group)
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=@ROOT@/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80 --workers 2 --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
