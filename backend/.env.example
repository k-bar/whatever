# Copy to backend/.env (gitignored). All values have local-dev defaults except the token.
DATABASE_URL=postgresql+psycopg://postgres@localhost:54329/warszawa
JWT_SECRET=dev-only-insecure-secret-change-me-in-prod
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# https://dane.um.warszawa.pl/en/key-api — ask Mateusz, never commit it
WARSAW_API_TOKEN=
